# Copy this file to .env and fill in real values. NEVER put real secrets here.

# --- Required -------------------------------------------------------------
# MongoDB Atlas connection string (Atlas > Connect > Drivers). Keep it secret.
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/"
MONGODB_DB_NAME="store"

# Long random string used to sign/hash sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string-of-48-chars-or-more"

# Admin login. Only this email + password can sign in to /admin (8+ characters).
# Change them here (and in Netlify env vars), restart/redeploy: the new login works
# at once and everyone signed in with the old one is signed out.
# (Older names ADMIN_INITIAL_EMAIL / ADMIN_INITIAL_PASSWORD also work.)
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="choose-a-strong-password"

# --- Optional -------------------------------------------------------------
# Shop WhatsApp number (used if not set in admin Settings). Digits, e.g. 919876543210
WHATSAPP_NUMBER=""

# Developer WhatsApp number, shown on the "Contact developer" button when storage is full.
DEVELOPER_WHATSAPP=""

# Safety cap for image storage in MongoDB (MB). Uploads are refused above it.
# Atlas free clusters have 512 MB total, shared with product data.
IMAGE_STORAGE_LIMIT_MB="380"
